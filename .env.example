# Copy to .env for local container runs. Do not commit real secrets.
# TG_LARN_BOT_TOKEN can also be exported from ~/.zprofile.
TG_LARN_BOT_TOKEN=

# MongoDB container credentials for local development.
MONGO_INITDB_ROOT_USERNAME=tglarn
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_DATABASE=tglarn

# Host-machine Python runs should use localhost because they run outside compose.
# deploy/compose.yml overrides MONGO_URI for the bot container to use host "mongo".
MONGO_URI=mongodb://tglarn:change-me@localhost:27017/tglarn?authSource=admin

# Bot behavior.
DEFAULT_MAP_VIEW=wide
GAME_ADAPTER=placeholder
# Set GAME_ADAPTER=relarn_process to use the upstream ReLarn pty bridge.
RELARN_BINARY_PATH=/opt/relarn/lib/relarn/relarn.bin
RELARN_INSTALL_ROOT=/opt/relarn
RELARN_CYCLE_TIMEOUT_SECONDS=3
RELARN_CYCLE_SETTLE_SECONDS=0.12
REPOSITORY_URL=https://github.com/SimonBorin/tglarn
LOG_LEVEL=INFO
DATABASE_STARTUP_ATTEMPTS=30
DATABASE_STARTUP_DELAY_SECONDS=2
